# El Ahorita · variables locales
# Copia este archivo como `.env` y rellena lo que tengas. No se sube al repo.
# En GitHub van como secrets con el mismo nombre (Settings -> Secrets -> Actions).

# --- guion y clasificacion con IA (obligatoria para el guion bueno) ---
DEEPSEEK_API_KEY=
# opcionales
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Telegram: mesa de edicion (botones publicar/descartar y /nota) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Voicebox: voz clonada (si no responde, se usa edge-tts y avisa) ---
VOICEBOX_URL=http://100.91.104.124:17493
VOICEBOX_PROFILE_ID=
VOICEBOX_TIMEOUT=240

# --- YouTube Shorts ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# public | private
YT_PRIVACIDAD=private
